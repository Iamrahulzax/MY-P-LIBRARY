# =====================================================================
# SECURITY NOTICE - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# DO NOT commit real secrets, passwords, or production keys to source control.
# Real .env files are automatically excluded by .gitignore.
#
# Recommended Best Practice:
# 1. Store keys in the encrypted Admin Security Vault in the web UI (/admin).
# 2. Or configure server-side environment variables (TMDB_API_KEY / RAWG_API_KEY)
#    in server.js so keys are proxied and NEVER exposed to client browsers.
# =====================================================================

# Server-Side Keys (Recommended for server.js proxy)
# TMDB_API_KEY=your_tmdb_api_key_here
# RAWG_API_KEY=your_rawg_api_key_here

# Client-Side Fallback Keys (Optional - Note: VITE_ keys are visible in client JS)
VITE_MOVIE_API_KEY=
VITE_GAME_API_KEY=
